# Story UI Configuration
# Copy this file to .env and configure your API keys

# =============================================================================
# LLM Provider API Keys
# =============================================================================
# Configure one or more providers. Story UI will use the first available.

# Claude (Anthropic)
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=your-claude-api-key
# Alternative key name also supported:
# ANTHROPIC_API_KEY=your-claude-api-key

# OpenAI
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Optional: Organization ID for team accounts
# OPENAI_ORG_ID=your-org-id

# Google Gemini
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Alternative key name also supported:
# GOOGLE_API_KEY=your-gemini-api-key

# Local model or router (LM Studio, Ollama, llama.cpp, OpenRouter — any
# OpenAI-compatible server). The model picker lists what the server offers
# this account; for OpenRouter, the models your provider settings allow.
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# LOCAL_LLM_BASE_URL=https://openrouter.ai/api/v1
# Only if the server requires one (LM Studio: Developer → Server Settings)
# LOCAL_LLM_API_KEY=your-token
# Optional: the model to use by default; otherwise the first one listed
# LOCAL_LLM_MODEL=qwen/qwen3-coder-30b
# Optional: a cheaper model for story titles and chat summaries; otherwise the
# model chosen for generation is used for those too
# LOCAL_LLM_SMALL_MODEL=anthropic/claude-haiku-5.5
# Optional: only offer these models (comma-separated); useful for OpenRouter
# LOCAL_LLM_MODELS=anthropic/claude-sonnet-5.5,qwen/qwen3-coder
# Optional: label in the model picker (default "Local")
# LOCAL_LLM_NAME=OpenRouter

# =============================================================================
# Default Model Selection
# =============================================================================
# These settings define the default provider and model for story generation.

# Default LLM provider (claude, openai, gemini, local)
DEFAULT_PROVIDER=claude

# Default model ID (Sept 2026)
# Claude models:
#   claude-opus-5        - Most capable at Opus pricing; the default for generation
#   claude-fable-5-1     - Anthropic's most capable model, higher price, thinking always on
#   claude-sonnet-5      - Faster and cheaper; good for iteration
#   claude-opus-4-8      - Previous Opus
#   claude-haiku-4-5     - Cheapest; used automatically for titles and summaries
# OpenAI models:
#   gpt-5.6-sol          - Flagship
#   gpt-5.6-terra        - Balanced
#   gpt-5.6-luna         - Cost-sensitive
# Gemini models:
#   gemini-3.1-pro       - Most capable Gemini
#   gemini-3.7-flash     - Fast, strong at coding
#   gemini-3.1-flash-lite - Cheapest
DEFAULT_MODEL=claude-opus-5

# Reasoning effort for Claude models that take one: low | medium | high | xhigh | max
# CLAUDE_EFFORT=high

# Legacy model config (still supported):
# CLAUDE_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# Server Configuration
# =============================================================================

# MCP server port (default: 4001)
# PORT=4001

# MCP port for the Storybook manager page (?path=/workspace/): Storybook inlines STORYBOOK_* into the manager build (read in templates/StoryUIV2/apiBase.ts)
# STORYBOOK_STORY_UI_PORT=4001

# CORS allowed origins (comma-separated) for external access
# STORY_UI_ALLOWED_ORIGINS=https://your-domain.com,https://storybook.your-domain.com

# Optional: Custom config file path
# STORY_UI_CONFIG_PATH=./story-ui.config.js

# =============================================================================
# Access Control
# =============================================================================
# By default the server binds 127.0.0.1 and answers only loopback requests.
# To reach it from another machine (a shared Storybook, Railway, a proxy),
# set a token. Every request must then carry it as
# "Authorization: Bearer <token>", or the site can be opened once with
# ?token=<token> to receive a cookie. A public deployment WITHOUT a token
# refuses to start; STORY_UI_ALLOW_UNAUTHENTICATED=true overrides that
# deliberately and is not recommended.
# STORY_UI_TOKEN=change-me-to-a-long-random-string
# STORY_UI_HOST=0.0.0.0
# STORY_UI_ALLOW_UNAUTHENTICATED=false

# Request body ceiling (images are downscaled in the browser first)
# STORY_UI_MAX_BODY=25mb

# Legacy runtime check (off by default; browser verification covers it)
# STORYBOOK_RUNTIME_VALIDATION=true
